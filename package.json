{
  "name": "vipcode",
  "version": "0.2.3",
  "description": "Agente de programación para la terminal que usa IAs gratuitas y salta a otro proveedor cuando uno se agota",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "llm",
    "free",
    "terminal",
    "spanish"
  ],
  "homepage": "https://github.com/PabloVip/vipcode#readme",
  "bugs": {
    "url": "https://github.com/PabloVip/vipcode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloVip/vipcode.git"
  },
  "license": "MIT",
  "author": "Pablo Vicente Juan (https://github.com/PabloVip)",
  "type": "module",
  "bin": {
    "vipcode": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-force-exit --test-timeout=120000 \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cross-spawn": "^7.0.6",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.12.0",
    "ink": "^8.0.0",
    "marked": "^18.1.2",
    "openai": "^7.45.1",
    "picocolors": "^1.1.1",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15"
  }
}
