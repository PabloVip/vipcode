# Dos preguntas de permiso seguidas (el modelo pide dos ficheros en la misma respuesta): la segunda tiene que responder a
# las teclas igual que la primera, y empezar con «Sí» marcado (lo lanza test/tui.test.mjs)
set timeout 30
log_user 1
set cli [lindex $argv 0]
match_max -d 200000

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

proc pausa {segundos} {
  set fin [expr {[clock milliseconds] + int($segundos * 1000)}]
  while {[clock milliseconds] < $fin} {
    expect {
      -timeout 0
      "@@nunca-sale@@" {}
      timeout {}
    }
    after 20
  }
}

spawn -noecho node $cli
stty rows 40 columns 120 < $spawn_out(slave,name)
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no arranca" }
}
pausa 0.3
send "escribe los dos"
pausa 0.3
send "\r"
expect {
  "Crear uno.txt" {}
  timeout { falla "no pregunta por el primero" }
}
pausa 0.3
# El primero: bajar hasta «No» (Sí · Sí y no preguntar más · No · No y explicar) y Enter: rechazado
send "\033\[B"
pausa 0.1
send "\033\[B"
pausa 0.2
send "\r"
expect {
  "Crear dos.txt" {}
  timeout { falla "no pregunta por el segundo" }
}
pausa 0.3
# El segundo empieza en «Sí»: Enter lo aprueba
send "\r"
expect {
  "FIN-PERMISOS" {}
  timeout { falla "el segundo diálogo no responde" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}
pausa 0.3
send "/exit"
pausa 0.3
send "\r"
expect {
  eof {}
  timeout { falla "/exit no cierra la interfaz" }
}
puts "\nTUI-PERMISOS-OK"
exit 0
