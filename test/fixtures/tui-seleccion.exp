# Pantalla completa: arrastrar con el ratón sobre la conversación la selecciona y la copia al soltar (lo lanza
# test/tui.test.mjs)
set timeout 30
log_user 1
set cli [lindex $argv 0]

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

# Espera sin dejar de leer la pantalla: con sleep, la salida de la pseudo-terminal se llena (en macOS enseguida, con la
# pantalla completa repintándose) y vipcode se queda parado escribiendo, sin atender al teclado
proc pausa {segundos} {
  set fin [expr {[clock milliseconds] + int($segundos * 1000)}]
  while {[clock milliseconds] < $fin} {
    expect {
      -timeout 0
      "@@nunca-sale@@" {}
      timeout {}
    }
    after 20
  }
}

spawn -noecho node $cli
stty rows 30 columns 100 < $spawn_out(slave,name)

expect {
  "Escribe tu mensaje" {}
  timeout { falla "no arranca la interfaz" }
}
send "largo\r"
expect {
  "LINEA-80" {}
  timeout { falla "no contesta" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}
pausa 0.5

# De la columna 3 de la primera fila a la 12 de la tercera, y soltar
send "\033\[<0;3;1M"
pausa 0.1
send "\033\[<32;8;2M"
pausa 0.1
send "\033\[<32;12;3M"
pausa 0.1
send "\033\[<0;12;3m"
expect {
  "copiado" {}
  timeout { falla "al soltar no dice que lo ha copiado" }
}

send "/exit\r"
expect {
  eof {}
  timeout { falla "/exit no cierra la interfaz" }
}
puts "\nTUI-SELECCION-OK"
exit 0
