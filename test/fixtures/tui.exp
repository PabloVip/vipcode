# Teclea en la interfaz de vipcode dentro de una pseudo-terminal (lo lanza test/tui.test.mjs)
set timeout 20
log_user 1
set cli [lindex $argv 0]

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

spawn -noecho node $cli
stty rows 40 columns 120 < $spawn_out(slave,name)

expect {
  "Escribe tu mensaje" {}
  timeout { falla "no aparece el cuadro de texto" }
}

# 1. Un mensaje normal
send "hola\r"
expect {
  "RESPUESTA-UNO" {}
  timeout { falla "no llega la respuesta al primer mensaje" }
}
# Debajo, el pie con el modelo que ha contestado y lo que ha tardado
expect {
  -re {p/m \S+ (<1|[0-9]+(,[0-9])?) s} {}
  timeout { falla "no aparece el pie con el modelo que ha contestado" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}
# Y en la barra de abajo, de quién es el plan gratis y cuánto queda
expect {
  "Proveedor P: *quedan 99/100 hoy" {}
  timeout { falla "la barra de abajo no dice de quién es el límite ni cuánto queda" }
}

# 1b. Una respuesta más ancha que la terminal se parte dentro de su hueco (120 columnas menos el «● »), no en el
# borde de la terminal, que la cortaría por en medio
send "largo\r"
expect {
  -re {y{118}\r?\n  y{12}} {}
  timeout { falla "la respuesta larga no se parte en su hueco" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre tras la respuesta larga" }
}

# 1c. Un comando que no cabe en el diálogo de permiso se escribe entero encima antes de preguntar (si no, la línea 31
# podría esconder algo); se rechaza
send "comando-largo\r"
expect {
  "LINEA-35" {}
  timeout { falla "no se ve el comando largo entero" }
}
expect {
  "justo encima" {}
  timeout { falla "el diálogo no avisa de que el comando entero está encima" }
}
send "n"
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre tras rechazar el comando largo" }
}

# 2. Edición con diálogo de permiso: se ve el diff y se acepta con «s»
send "cambia el fichero\r"
expect {
  "Editar hola.txt" {}
  timeout { falla "no aparece el diálogo de permiso" }
}
expect {
  "+ adios" {}
  timeout { falla "el diálogo no enseña el diff" }
}
send "s"
expect {
  "RESPUESTA-DOS" {}
  timeout { falla "no termina tras aceptar el permiso" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}

# 3. Autocompletado de @fichero con Tab
send "mira @hol"
expect {
  "@hola.txt" {}
  timeout { falla "no sugiere @hola.txt" }
}
send "\t"
sleep 0.3
send "\r"
expect {
  "ADJUNTO-OK" {}
  timeout { falla "no se adjuntó el fichero" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}

# 4. Tab cambia al agente planear
send "\t"
# Entre el nombre del agente y el resto de la barra hay códigos de color
expect {
  -re {planear(\x1b\[[0-9;]*m)*\s*·} {}
  timeout { falla "Tab no cambia de agente" }
}
sleep 0.3
send "\t"
expect {
  -re {profe(\x1b\[[0-9;]*m)*\s*·} {}
  timeout { falla "Tab no pasa al agente profe" }
}
sleep 0.3
send "\t"
expect {
  -re {programar(\x1b\[[0-9;]*m)*\s*·} {}
  timeout { falla "Tab no vuelve al agente programar" }
}
sleep 0.3

# 5. Ctrl+P abre la paleta de comandos y Esc la cierra
send "\x10"
expect {
  "Comandos y skills" {}
  timeout { falla "Ctrl+P no abre la paleta" }
}
# Con expect (y no sleep) se sigue leyendo la pantalla: si no, la terminal se llena y vipcode espera
send "\033"
expect {
  "Escribe tu mensaje" {}
  timeout { falla "Esc no cierra la paleta" }
}

# 6. !comando: se ejecuta en la terminal y se ve su salida (lo escrito no contiene la salida)
send {!printf 'SAL%s' IDA-SHELL}
send "\r"
expect {
  "SALIDA-SHELL" {}
  timeout { falla "no se ve la salida del !comando" }
}
expect {
  "digo 0" {}
  timeout { falla "el !comando no termina" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre tras el !comando" }
}

# 7. Volver a la sesión: /new y luego /sessions enseña la conversación anterior
send "/new\r"
expect {
  "Sesión nueva" {}
  timeout { falla "/new no empieza otra sesión" }
}
send "/sessions\r"
expect {
  "Sesiones de esta carpeta" {}
  timeout { falla "/sessions no abre la lista" }
}
send "\r"
expect {
  "Conversación anterior" {}
  timeout { falla "al cargar la sesión no se ve la conversación" }
}
expect {
  "RESPUESTA-UNO" {}
  timeout { falla "no se ve lo que contestó antes" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre tras cargar la sesión" }
}

# 8. /models abre la lista y Esc la cierra
send "/models\r"
expect {
  "Elige el modelo" {}
  timeout { falla "/models no abre la lista" }
}
send "\033"
sleep 0.5

# 9. /exit sale
send "/exit\r"
expect {
  eof {}
  timeout { falla "/exit no cierra la interfaz" }
}
puts "\nTUI-OK"
exit 0
