# Avisos al abrir vipcode: una interfaz que ya no existe, la versión nueva y la bienvenida de la primera vez (lo lanza
# test/tui.test.mjs)
set timeout 20
log_user 1
set cli [lindex $argv 0]
# Con la pantalla completa cada repintado ocupa varios KB: con el búfer de serie (2.000 bytes), expect tiraría lo de
# arriba de la pantalla antes de buscar en ello
match_max -d 200000

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

spawn -noecho node $cli
stty rows 40 columns 120 < $spawn_out(slave,name)

# 1. Las novedades de esta versión se ven desde su título, aunque debajo vengan el recuadro de la versión nueva y la
# bienvenida (si no, solo se vería su final)
expect {
  "Novedades de vipcode" {}
  timeout { falla "no se ve el título de las novedades de esta versión" }
}

# 2. Bienvenida: se acepta con Enter («Empezar»)
expect {
  "Te damos la bienvenida" {}
  timeout { falla "no aparece la bienvenida" }
}
send "\r"
expect {
  "Escribe tu mensaje" {}
  timeout { falla "la bienvenida no se cierra" }
}

# 3. La barra de abajo sigue recordando la versión nueva
expect {
  "99.0.0 trae arreglos de seguridad" {}
  timeout { falla "la barra de abajo no recuerda la versión nueva con arreglos de seguridad" }
}

# 4. Arriba del todo (Ctrl+Inicio), el aviso de que la interfaz de la configuración ya no existe (se usa la de serie)
send "\033\[1;5H"
expect {
  -re {Alto contraste\S* ya no est} {}
  timeout { falla "no avisa de que la interfaz de alto contraste ya no está" }
}

# 5. Y abajo del todo (Ctrl+Fin), el recuadro de la versión nueva con arreglos de seguridad
send "\033\[1;5F"
expect {
  "nueva de vipcode con arreglos de seguridad" {}
  timeout { falla "el recuadro de versión nueva no avisa de los arreglos de seguridad" }
}

send "/exit\r"
expect {
  eof {}
  timeout { falla "/exit no cierra la interfaz" }
}
puts "\nTUI-AVISOS-OK"
exit 0
