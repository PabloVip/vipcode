# Salir mientras una herramienta está en marcha: /exit o Ctrl+C dos veces, sin esperar a que termine (lo lanza
# test/procesos.test.mjs). El primer argumento detrás del programa dice cómo salir: exit, ctrl-c o cola (con un mensaje en cola)
set timeout 30
log_user 1
set cli [lindex $argv 0]
set modo [lindex $argv 1]
match_max -d 200000

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

# Espera sin dejar de leer la pantalla: con «after» a secas, la salida de vipcode llena el búfer de la terminal, vipcode se
# queda bloqueado escribiendo y las teclas siguientes le llegan todas juntas
proc pausa {segundos} {
  set fin [expr {[clock milliseconds] + int($segundos * 1000)}]
  while {[clock milliseconds] < $fin} {
    expect {
      -timeout 0
      "@@nunca-sale@@" {}
      timeout {}
    }
    after 20
  }
}

spawn -noecho node $cli --yolo
stty rows 40 columns 120 < $spawn_out(slave,name)

expect {
  "Escribe tu mensaje" {}
  timeout { falla "no arranca" }
}
send "lanza el comando\r"

# Espera a que el comando haya arrancado y sigue leyendo la pantalla
set fichero "padre.pid"
set fin [expr {[clock milliseconds] + 20000}]
while {![file exists $fichero] || [file size $fichero] == 0} {
  if {[clock milliseconds] > $fin} {
    falla "el comando no arranca"
  }
  expect {
    -timeout 0
    "@@nunca-sale@@" {}
    timeout {}
  }
  after 50
}
pausa 0.5

if {$modo eq "exit"} {
  send "/exit"
  pausa 0.2
  send "\r"
} elseif {$modo eq "cola"} {
  # Un mensaje que se queda en cola (está trabajando) y luego /exit: al cerrar no se puede mandar a la IA
  # (Enter aparte, como al teclear: si llega pegado al texto, la caja lo toma como un salto de línea, igual que al pegar)
  send "SEGUNDO-MENSAJE"
  pausa 0.3
  send "\r"
  expect {
    "en cola" {}
    timeout { falla "el mensaje no se queda en cola" }
  }
  pausa 0.3
  send "/exit"
  pausa 0.3
  send "\r"
} else {
  send "\x03"
  pausa 0.3
  send "\x03"
}

set timeout 8
expect {
  eof {}
  timeout { falla "no sale con $modo" }
}
puts "\nTUI-SALIR-OK"
