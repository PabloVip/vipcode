# Teclas que llegan seguidas, sin esperar a que se pinte, en la caja de escribir y en un menú: no se puede perder ninguna (lo lanza
# test/tui.test.mjs)
set timeout 30
log_user 1
set cli [lindex $argv 0]
match_max -d 200000

proc falla {motivo} {
  puts "\nFALLO: $motivo"
  exit 1
}

proc pausa {segundos} {
  set fin [expr {[clock milliseconds] + int($segundos * 1000)}]
  while {[clock milliseconds] < $fin} {
    expect {
      -timeout 0
      "@@nunca-sale@@" {}
      timeout {}
    }
    after 20
  }
}

spawn -noecho node $cli
stty rows 30 columns 110 < $spawn_out(slave,name)
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no arranca" }
}
pausa 0.3
# La caja de escribir: letras y borrados seguidos
send "h"
send "o"
send "l"
send "x"
send "\177"
send "a"
send "\177\177\177\177"
send "a"
send "d"
send "i"
send "o"
send "s"
pausa 0.3
send "\r"
expect {
  "ECO:adios" {}
  timeout { falla "se han perdido teclas en la caja de escribir" }
}
expect {
  "Escribe tu mensaje" {}
  timeout { falla "no vuelve a quedar libre" }
}
# Las sugerencias de la caja: «/ex» ofrece /export y /exit. ↓ y Enter llegando juntos eligen la segunda (/exit), no la que
# estaba marcada la última vez que se pintó (/export)
send "/ex"
expect {
  "/export" {}
  timeout { falla "no salen las sugerencias de /ex" }
}
pausa 0.5
send "\033\[B\r"
expect {
  eof {}
  "Conversación guardada en" { falla "↓ y Enter juntos han elegido /export (la primera sugerencia) en vez de /exit" }
  timeout { falla "↓ y Enter juntos no han elegido /exit" }
}
puts "\nTUI-TECLAS-OK"
exit 0
